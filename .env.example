# Febris Node -- clone-and-run environment (docker-compose reads ./.env automatically).
#
# EASIEST: do not edit this file -- run ./selfhost/generate-env.sh, which writes a .env with
# fresh random secrets. This file documents every knob. .env is git-ignored; never commit it.

# --- required secrets (compose refuses to start while these are blank) -------------------

# Password for the stack's own Postgres server (user 'febris'). Local to the compose network.
POSTGRES_PASSWORD=

# HMAC secret the node signs its own JWTs with (portal mints, API validates).
# Use a long random value, e.g.: openssl rand -hex 32
NODE_JWT_SECRET=

# --- bootstrap admin (first login, no SMTP needed) ---------------------------------------

# How the first administrator comes to exist. There are three paths, and the two values below
# choose between them.
#
#   BOTH BLANK, as shipped. The node mints a one-time setup token, prints it to the container
#     log, and you claim it at /setup within 60 minutes. No SMTP required. This is what you get
#     by copying this file unedited.
#
#   BOTH SET. The account is created with that password on first boot. This is what
#     selfhost/generate-env.sh does, and it is the least friction for a local trial.
#
#   EMAIL SET, PASSWORD BLANK. The account is created with NO password, and the only route in is
#     Forgot Password, which needs SMTP a fresh node has not configured. There is no way to log
#     in at all. Avoid it. This file used to ship exactly that combination.
#
# If you set a password the policy is at least 8 characters with upper, lower and a digit, and a
# symbol is optional. A password that fails the policy is REJECTED by the seed and the node boots
# with no admin account.
NODE_ADMIN_EMAIL=
NODE_ADMIN_PASSWORD=

# --- ports -------------------------------------------------------------------------------

# HTTPS entry (Caddy): portal at https://febris.localhost:PORT, API at
# https://api.febris.localhost:PORT.
NODE_HTTPS_PORT=8443

# Plain-HTTP API port, for host-local health probes: http://127.0.0.1:PORT
NODE_API_HTTP_PORT=8081

# Which interface that plain-HTTP port binds to. LOOPBACK BY DEFAULT: the API carries device
# tokens, the hardware credential and learner records, so publishing it to the LAN sends all of
# that in cleartext. Point launcher and mobile at the HTTPS API host instead.
# Set 0.0.0.0 ONLY if a device genuinely cannot trust the local CA, and only on a network you
# control.
NODE_API_HTTP_BIND=127.0.0.1

# Just-in-time provisioning for external identity providers. Ships closed: a user your IdP
# authenticates for the first time is turned away unless an admin already provisioned them.
# Set true to auto-create a local account on first external login. Does not affect local
# password login or the bootstrap admin.
NODE_AUTO_PROVISION_JIT=false

# --- optional SMTP (password resets / user invites) --------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER=
SMTP_PASSWORD=

# --- bring your own reverse proxy (optional) ----------------------------------------------
# Only read when you run with the selfhost/docker-compose.byo-proxy.yml overlay, which publishes
# the portal for an existing reverse proxy and switches the bundled Caddy off. See
# "If you already run a reverse proxy" in SELF_HOSTING.md.
#
# Loopback by default: this endpoint is plain HTTP and the portal's auth cookie is Secure, so
# exposing it to the LAN would be a downgrade. Widen the bind only for a proxy on another machine,
# and then add that proxy to ForwardedHeaders__KnownNetworks__1.
NODE_PORTAL_HTTP_BIND=127.0.0.1
NODE_PORTAL_HTTP_PORT=8082
