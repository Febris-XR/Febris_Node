{
  "Identity": {
    "_comment": "Operator-configurable identity/auth/lifecycle policy (see Identity-policy gates in README.md). Safe defaults; override any value here or via env var Identity__<Section>__<Key>. These same defaults live in code, so removing this section changes nothing.",
    "Registration": {
      "Mode": "AdminOnly",
      "AllowedEmailDomains": [],
      "RequireConfirmedEmail": true,
      "RequireAdminApproval": false,
      "AutoProvisionJit": false
    },
    "Password": {
      "RequiredLength": 8,
      "RequireDigit": true,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": false,
      "RequiredUniqueChars": 1
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "EnabledForNewUsers": true
    },
    "TwoFactor": {
      "Enforcement": "Off"
    },
    "Login": {
      "AllowLocalPassword": true,
      "AllowSelfServiceReset": true
    },
    "Session": {
      "LifetimeMinutes": 60,
      "Sliding": true,
      "AbsoluteTimeoutMinutes": null
    },
    "AccountLifecycle": {
      "SoftDeleteOnly": true,
      "AllowSelfServiceDeletion": false,
      "AllowPersonalDataExport": true,
      "PurgeAfterDays": null
    }
  },
  "AnalyticsRetention": {
    "PurgeAfterDays": 365,
    "AnonymiseAfterDays": 90
  },
  "Transport": {
    "_comment": "Operator-configurable transport security. Safe defaults preserve prior production behavior; a missing section keeps them. HSTS applies in non-Development only.",
    "Hsts": {
      "Enabled": true,
      "MaxAgeDays": 365,
      "IncludeSubdomains": true,
      "Preload": false
    },
    "HttpsRedirection": false,
    "Cors": {
      "_comment": "Hostnames allowed cross-origin, e.g. 'app.example.com' (exact) or '.example.com' (domain + subdomains). Empty = same-origin + localhost only. List YOUR frontend host(s).",
      "AllowedHosts": [],
      "AllowCredentials": true
    },
    "SecurityHeaders": {
      "XContentTypeOptions": true,
      "XXssProtection": true,
      "XFrameOptions": "SameOrigin"
    }
  },
  "ConnectionStrings": {
    "UserDBConnection": "{UserDBConnectionString}",
    "DataDBConnection": "{DataDBConnectionString}",
    "XAPIDBConnection": "{XAPIDBConnectionString}",
    "AnalyticsDBConnection": "{AnalyticsDBConnectionString}"
  },
  "RedisConnectionStrings": {
    "AuthConnection": "localhost:6379",
    "HardwareConnection": "localhost:6379"
  },
  "EmailSender": {
    "Host": "smtp.example.com",
    "Port": 587,
    "EnableSSL": false,
    "Sender": "{EmailSenderEmailAddress}",
    "Password": "{EmailSenderPassword}",
    "SenderName": "Febris",
    "CheckCertificateRevocation": false
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    // EMPTY ON PURPOSE. AspNetCoreRateLimit reads this header with NO trust check, so any
    // caller could set it and land in a bucket of their choosing -- measured: 8 requests
    // with a rotating X-Real-IP were never limited, while the same 8 with it empty were.
    // The node was only safe behind the bundled proxy because Caddy OVERWRITES the header.
    // Empty makes the limiter fall back to Connection.RemoteIpAddress, which the
    // ForwardedHeaders middleware has already resolved using the operator-declared trusted
    // proxies. One trust boundary instead of three.
    //
    // IF YOU RUN BEHIND A PROXY you MUST declare it under "ForwardedHeaders" or every
    // caller collapses into one bucket and five requests lock login for everyone.
    "RealIpHeader": "",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/Identity/Account/Login",
        "Period": "15m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/Identity/Account/ForgotPassword",
        "Period": "15m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/Identity/Account/Register",
        "Period": "15m",
        "Limit": 5
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      }
    ]
  },
  "SmbClient": {
    "Path": "{SmbClientPath}"
  },
  "FileSystem": {
    "UniqueFileSystemPath": "{UniqueFileSystemPath}\\"
  },
  "Serilog": {
    "Using": [],
    "MinimumLevel": {

      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }

    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": "360"
        }
      }

    ]
  },
  "AppKeys": {
    "KeyRingPath": "keys"
  },
  "PackageFeed": {
    // Scheduled sync of the software catalogue from a package feed.
    //
    // BLANK URL BY DEFAULT, which leaves the sync idle: a node reaches out to nothing until an
    // operator names a feed they trust. Set it and the node keeps its catalogue current on its
    // own. This matters more than it looks: the manual upload path was removed, so a feed is now
    // the ONLY way packages reach a node, and a node holding nothing cannot serve devices. The
    // Mobile Server fetches the Companion FROM the node, so headsets cannot be updated until the
    // catalogue has it.
    //
    // The sync enforces https, verifies each artifact's sha256 before ingesting it, and never
    // overwrites a held package whose checksum changed. Runs below one hour apart are raised to
    // one hour. The portal's manual sync form is unchanged and still available.
    "Url": "",
    "Channel": "stable",
    "IntervalHours": 24
  },
  "ClientDownloads": {
    // Where the Software Repository pages send an operator when this node holds no local copy
    // of a client package. A node's catalogue starts empty and only fills by manual upload or a
    // feed sync, and nothing obliges a self-host operator to do either, so those pages used to
    // be a permanent dead end on a fresh deployment.
    //
    // Local package always wins. This is only consulted when nothing is held, so an operator who
    // uploads their own build keeps serving it and never sees an external link.
    //
    // BLANK IT to disable link-out entirely. An air-gapped node then shows the plain empty state
    // and renders no external URL at all. A LAN mirror works too: point it at any http(s) root
    // that serves the same page, including one on a subdirectory.
    //
    // Rendering a link is NOT a network call. The node never requests these URLs; only the
    // operator's browser does, and only if they click.
    "BaseUrl": "https://www.febr.is"
  },
  // GeoDataUrls is gone. It configured a geocoder whose only reader was the Leaflet map the
  // owner ruled out and ROADMAP 18 removed, leaving a save-path lookup writing coordinates
  // nothing displayed. The key shipped blank so the call already could not succeed, and its
  // failure was suppressed. Removing the caller removes the last outbound destination a node
  // could reach without the operator asking for it.
  "AllowedHosts": "*"
}